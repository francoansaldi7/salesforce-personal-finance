<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Monthly_Limit_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>Monthly_Limit__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Monthly_Limit__c</errorDisplayField>
    <errorMessage>Monthly limit must be greater than zero.</errorMessage>
</ValidationRule>
