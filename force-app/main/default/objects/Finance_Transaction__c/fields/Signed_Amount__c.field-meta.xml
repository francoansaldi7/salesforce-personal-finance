<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Signed_Amount__c</fullName>
    <description>Amount in AUD, negative for expenses. Handy for reports that net income against expenses.</description>
    <formula>IF(ISPICKVAL(Type__c, &apos;Expense&apos;), -Amount_AUD__c, Amount_AUD__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Signed Amount (AUD)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
